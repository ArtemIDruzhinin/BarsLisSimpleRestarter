[Unit]
Description=BarsLis Web Restarter
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/barslis-restarter
Restart=on-failure
RestartSec=5

# Разрешаем только эту конкретную команду через sudo, либо запускаем от root
# Если сервис запущен НЕ от root — добавьте правило в /etc/sudoers:
#   www-data ALL=(ALL) NOPASSWD: /bin/systemctl restart BarsGroup.DM.service 
User=root

[Install]
WantedBy=multi-user.target
